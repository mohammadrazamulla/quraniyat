{
  "name": "Quraniyat",
  "short_name": "Quraniyat",
  "description": "Quran reader with Kanzul Iman translation, Zikr, Darood, Duas, Qibla, and prayer times.",
  "id": "./index.html",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "portrait",
  "background_color": "#0c2b2a",
  "theme_color": "#0c2b2a",
  "lang": "en",
  "dir": "ltr",
  "categories": ["books", "education", "lifestyle"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/screenshot_1_reader_dark.png",
      "sizes": "824x1830",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Quran reader with Kanzul Iman Roman Urdu translation (Dark mode)"
    },
    {
      "src": "screenshots/screenshot_2_zikr_dark.png",
      "sizes": "824x1830",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Zikr and Adhkar with daily counters (Dark mode)"
    },
    {
      "src": "screenshots/screenshot_3_audioquran_light.png",
      "sizes": "824x1830",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Audio Quran playback on Home (Light mode)"
    },
    {
      "src": "screenshots/screenshot_4_dua_light.png",
      "sizes": "824x1830",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Everyday Duas (Light mode)"
    }
  ],
  "shortcuts": [
    {
      "name": "Qibla Direction",
      "short_name": "Qibla",
      "description": "Jump straight to the Qibla compass",
      "url": "./index.html?screen=qibla",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Zikr & Adhkar",
      "short_name": "Zikr",
      "description": "Jump straight to Zikr and daily adhkar",
      "url": "./index.html?screen=zikr",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Duas",
      "short_name": "Duas",
      "description": "Jump straight to everyday duas",
      "url": "./index.html?screen=duas",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
